% Optional scientific plotting styles. Load after \usetheme{PCL}.
\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{pclplots}[2026/10/20 v2.0 PCL plot styles]
\RequirePackage{pgfplots}
\pgfplotsset{
  compat=1.18,
  pcl axis/.style={
    width=\linewidth,height=46mm,
    axis lines=left,
    axis line style={PCLGray,line width=0.45pt},
    tick style={PCLGray,line width=0.4pt},
    tick align=outside,
    tick label style={font=\fontsize{8}{10}\selectfont,text=PCLInk},
    label style={font=\fontsize{9}{11}\selectfont,text=PCLInk},
    grid=major,
    major grid style={PCLLine,line width=0.3pt,densely dotted},
    legend style={draw=none,fill=white,font=\fontsize{8}{10}\selectfont,
      cells={anchor=west},inner sep=1.5pt},
    legend pos=north east,
    scaled ticks=false,
    every axis plot/.append style={line width=0.9pt,mark size=1.5pt},
    clip=true
  },
  pcl method/.style={PCLBlue,solid,mark=*},
  pcl baseline/.style={PCLBaseline,dashed,mark=square*},
  pcl reference/.style={PCLReference,dashdotted,mark=triangle*}
}
\endinput
