      \node[anchor=north west,inner sep=0] at (0,0)
        {\includegraphics[width=160mm,height=90mm]{\PCLAssetPath closing-background.jpg}};
      \begin{scope}
        \clip (135.89,20.57) circle (9.59);
        \node[anchor=north west,inner sep=0] at (126.3,10.98)
          {\includegraphics[width=19.18mm]{\PCLAssetPath logo-cover.jpg}};
      \end{scope}
    \end{pclcanvas}}
  \begin{frame}[plain]
    \begin{pclcanvas}
      \node[anchor=west,inner sep=0,text width=145mm,font=\fontsize{21}{28}\selectfont\bfseries]
        at (5.5,63) {#1};
    \end{pclcanvas}
  \end{frame}\endgroup
}
\mode<all>
