% Measure actual TOC entries, then paginate without shrinking the text.
\newlength{\pcl@tocnumberwidth}
% Standard Beamer .toc records are consumed; ordinary \tableofcontents
% remains available and its Beamer templates above are left intact.
\ExplSyntaxOn
\seq_new:N \l_pcl_toc_entries_seq
\seq_new:N \l_pcl_toc_pages_seq
\prop_new:N \l_pcl_toc_short_prop
\tl_new:N \l_pcl_toc_page_tl
\dim_new:N \l_pcl_toc_used_dim
\dim_new:N \l_pcl_toc_entry_dim
\box_new:N \l_pcl_toc_entry_box
\int_new:N \l_pcl_toc_current_page_int
\NewDocumentCommand \PCLTOCShortName { m m }
  { \prop_put:Nnn \l_pcl_toc_short_prop {#1} {#2} }
\NewDocumentCommand \PCLSection { o m }
  {
    \IfNoValueTF{#1}{\section{#2}}
      {
        \addtocontents{toc}{\protect\PCLTOCShortName{\int_eval:n{\value{section}+1}}{#1}}
        \section[#1]{#2}
      }
  }
\cs_new_protected:Npn \pcl_toc_entry:nnnn #1#2#3#4
  {
    \begin{minipage}{100mm}
      \raggedright\usebeamerfont{section~in~toc}
      \int_compare:nNnTF {#1} = {\int_max:nn{1}{\value{section}}}
        {\color{PCLRed}}{\color{PCLBlue}}
      \settowidth{\pcl@tocnumberwidth}{\zhnumber{#4}、}
      \ifdim\pcl@tocnumberwidth<10.7mm\setlength{\pcl@tocnumberwidth}{10.7mm}\fi
      \hangindent=\pcl@tocnumberwidth\hangafter=1
      \noindent\makebox[\pcl@tocnumberwidth][l]{\zhnumber{#4}、}%
      \hyperlink{Navigation#3}
        {\prop_if_in:NnTF \l_pcl_toc_short_prop {#1}
          {\prop_item:Nn \l_pcl_toc_short_prop {#1}}{#2}}
      \par
    \end{minipage}
  }
\cs_new_protected:Npn \pcl_toc_flush:
  {
    \tl_if_empty:NF \l_pcl_toc_page_tl
      {\seq_put_right:NV \l_pcl_toc_pages_seq \l_pcl_toc_page_tl}
    \tl_clear:N \l_pcl_toc_page_tl
    \dim_zero:N \l_pcl_toc_used_dim
  }
\cs_new_protected:Npn \pcl_toc_add:nnnn #1#2#3#4
  {
    \hbox_set:Nn \l_pcl_toc_entry_box {\pcl_toc_entry:nnnn{#1}{#2}{#3}{#4}}
    \dim_set:Nn \l_pcl_toc_entry_dim
      {\box_ht:N \l_pcl_toc_entry_box + \box_dp:N \l_pcl_toc_entry_box}
    \dim_compare:nNnT {\l_pcl_toc_entry_dim} > {\PCLTOCHeight}
      {\PackageError{beamerthemePCL}{A~TOC~entry~exceeds~the~safe~area}
        {Use~a~short~name~with~PCLSection[short]{long}.}}
    \tl_if_empty:NF \l_pcl_toc_page_tl
      {
        \dim_compare:nNnT
          {\l_pcl_toc_used_dim+\PCLTOCGap+\l_pcl_toc_entry_dim} > {\PCLTOCHeight}
          {\pcl_toc_flush:}
      }
    \tl_if_empty:NF \l_pcl_toc_page_tl
      {
        \tl_put_right:Nn \l_pcl_toc_page_tl {\vspace{\PCLTOCGap}}
        \dim_add:Nn \l_pcl_toc_used_dim {\PCLTOCGap}
      }
    \tl_put_right:Nn \l_pcl_toc_page_tl {\noindent\pcl_toc_entry:nnnn{#1}{#2}{#3}{#4}\par}
    \dim_add:Nn \l_pcl_toc_used_dim {\l_pcl_toc_entry_dim}
    \int_compare:nNnT {#1} = {\value{section}}
      {\int_set:Nn \l_pcl_toc_current_page_int {\seq_count:N \l_pcl_toc_pages_seq+1}}
  }
\cs_new_protected:Npn \pcl_toc_read:
  {
    \seq_clear:N \l_pcl_toc_entries_seq
    \seq_clear:N \l_pcl_toc_pages_seq
    \prop_clear:N \l_pcl_toc_short_prop
    \tl_clear:N \l_pcl_toc_page_tl
    \dim_zero:N \l_pcl_toc_used_dim
    \int_zero:N \l_pcl_toc_current_page_int
    \cs_set_protected:Npn \beamer@sectionintoc ##1##2##3##4##5
      {
        \int_compare:nNnT {##4} = {\value{part}}
          {\seq_put_right:Nn \l_pcl_toc_entries_seq {{##1}{##2}{##3}{##5}}}
      }
    \cs_set:Npn \beamer@subsectionintoc ##1##2##3##4##5##6 {}
    \cs_set:Npn \beamer@subsubsectionintoc ##1##2##3##4##5##6##7 {}
    \makeatletter
    \InputIfFileExists{\jobname.toc}{}{}
    \makeatother
    \seq_map_inline:Nn \l_pcl_toc_entries_seq {\pcl_toc_add:nnnn ##1}
    \pcl_toc_flush:
    \seq_if_empty:NT \l_pcl_toc_pages_seq
      {\seq_put_right:Nn \l_pcl_toc_pages_seq
        {\color{PCLGray}\small 添加章节后重新编译以生成目录。}}
  }
\cs_new_protected:Npn \pcl_toc_render:nn #1#2
  {
    \begin{frame}[plain]
      \begin{pclcanvas}
        \node[inner~sep=0,anchor=west]~at~(50.8,49.1)
          {\begin{minipage}{100mm}\setlength{\parskip}{0pt}\offinterlineskip#2\end{minipage}};
        \int_compare:nNnT {\seq_count:N \l_pcl_toc_pages_seq} > {1}
          {\node[anchor=west,inner~sep=0,text=PCLGray,font=\scriptsize]~at~(50.8,85)
            {目录~#1~/~\int_eval:n{\seq_count:N \l_pcl_toc_pages_seq}};}
      \end{pclcanvas}
    \end{frame}
  }
\cs_new_protected:Npn \pcl_toc_frames:n #1
  {
    \group_begin:
      \setbeamertemplate{background}{\pcl@contentsbackground}
      \pcl_toc_read:
      \seq_map_indexed_inline:Nn \l_pcl_toc_pages_seq
        {
          \bool_lazy_or:nnT
            {\int_compare_p:n{#1=0}}
            {\int_compare_p:n{##1=\int_max:nn{1}{\l_pcl_toc_current_page_int}}}
            {\pcl_toc_render:nn{##1}{##2}}
        }
    \group_end:
  }
\NewDocumentCommand \PCLContentsFrame {} {\pcl_toc_frames:n{0}}
\NewDocumentCommand \PCLSectionFrame {} {\pcl_toc_frames:n{1}}
\ExplSyntaxOff
\newcommand{\PCLSectionFramesOn}{\AtBeginSection[]{\PCLSectionFrame}}
\newcommand{\PCLSectionFramesOff}{\AtBeginSection[]{}}

