% Public layout settings. Keep the reference canvas at 160 x 90 mm.
\newlength{\PCLMargin}
\newlength{\PCLTitleLeft}
\newlength{\PCLTitleRight}
\newlength{\PCLTitleTop}
\newlength{\PCLTitleGap}
\newlength{\PCLLogoSize}
\newlength{\PCLTOCGap}
\newlength{\PCLTOCHeight}
\newlength{\PCLCoverHeight}
\setlength{\PCLMargin}{5.5mm}
\setlength{\PCLTitleLeft}{20.8mm}
\setlength{\PCLTitleRight}{18mm}
\setlength{\PCLTitleTop}{4.7mm}
\setlength{\PCLTitleGap}{2mm}
\setlength{\PCLLogoSize}{10.4mm}
\setlength{\PCLTOCGap}{4.65mm}
\setlength{\PCLTOCHeight}{60mm}
\setlength{\PCLCoverHeight}{37mm}
\pgfkeys{/pcl/.is family,/pcl,
  margin/.code=\setlength{\PCLMargin}{#1},
  title left/.code=\setlength{\PCLTitleLeft}{#1},
  title right/.code=\setlength{\PCLTitleRight}{#1},
  title top/.code=\setlength{\PCLTitleTop}{#1},
  title gap/.code=\setlength{\PCLTitleGap}{#1},
  logo size/.code=\setlength{\PCLLogoSize}{#1},
  toc gap/.code=\setlength{\PCLTOCGap}{#1},
  title color/.code=\setbeamercolor{frametitle}{fg=#1}}
\newcommand{\PCLSetup}[1]{%
  \pgfkeys{/pcl,#1}%
  \setbeamersize{text margin left=\PCLMargin,text margin right=\PCLMargin}}

\setbeamercolor{normal text}{fg=PCLInk,bg=white}
\setbeamercolor{structure}{fg=PCLBlue}
\setbeamercolor{alerted text}{fg=PCLRed}
\setbeamercolor{frametitle}{fg=PCLTitleRed,bg=white}
\setbeamercolor{title}{fg=PCLBlue}
\setbeamercolor{section in toc}{fg=PCLRed}
\setbeamercolor{section in toc shaded}{fg=PCLBlue}
\setbeamercolor{block title}{fg=white,bg=PCLBlue}
\setbeamercolor{block body}{fg=PCLInk,bg=PCLLight}
\setbeamercolor{block title alerted}{fg=white,bg=PCLTitleRed}
\setbeamercolor{block body alerted}{fg=PCLInk,bg=PCLRed!4}
\setbeamerfont{normal text}{size=\fontsize{11}{15}\selectfont}
\setbeamerfont{frametitle}{size=\fontsize{16}{19}\selectfont,series=\bfseries}
\setbeamerfont{framesubtitle}{size=\fontsize{10}{13}\selectfont,series=\mdseries}
\setbeamercolor{framesubtitle}{fg=PCLGray}
\setbeamerfont{title}{size=\fontsize{17}{23}\selectfont,series=\bfseries}
\setbeamerfont{section in toc}{size=\fontsize{15.175}{20}\selectfont,series=\bfseries}
\setbeamerfont{block title}{size=\normalsize,series=\bfseries}
\setbeamerfont{block body}{size=\normalsize}
\PCLSetup{}
\beamer@centeredfalse
\setbeamertemplate{navigation symbols}{}
\setbeamertemplate{headline}{}
\setbeamertemplate{items}[square]
\setbeamertemplate{blocks}[rounded][shadow=false]
\setbeamertemplate{caption}[numbered]
\setbeamerfont{caption}{size=\scriptsize}
\setbeamercolor{caption name}{fg=PCLBlue}
\AtBeginDocument{\usebeamerfont{normal text}}
\addtobeamertemplate{itemize/enumerate body begin}{\setlength{\itemsep}{1.5mm}}{}

