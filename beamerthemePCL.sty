% Absolute decorations are expressed on the 160 x 90 mm reference canvas.
\newenvironment{pclcanvas}{%
  \begin{tikzpicture}[remember picture,overlay,x=1mm,y=-1mm]
  \begin{scope}[shift={(current page.north west)}]
}{\end{scope}\end{tikzpicture}}
\newcommand{\pcl@ornament}{%
  \fill[PCLAccent] (4.8,7.42) rectangle (6.8,9.42);
  \fill[PCLAccent] (7.35,7.42) rectangle (9.35,9.42);
  \shade[left color=PCLAccent,right color=white] (9.95,7.42) rectangle (16.5,9.42);
}
\newcommand{\pcl@bodybackground}{%
  \begin{pclcanvas}
    \pcl@ornament
    \node[anchor=north west,inner sep=0] at (145.65,3.05)
      {\includegraphics[width=\PCLLogoSize]{\PCLAssetPath logo-cover.jpg}};
  \end{pclcanvas}
}
\setbeamertemplate{background}{\pcl@bodybackground}
\setbeamertemplate{frametitle}{%
  \nointerlineskip\vskip\PCLTitleTop
  \hbox{\hskip\dimexpr\PCLTitleLeft-\PCLMargin\relax
  \vbox{\hsize=\dimexpr\paperwidth-\PCLTitleLeft-\PCLTitleRight\relax
    \raggedright
    {\usebeamerfont{frametitle}\usebeamercolor[fg]{frametitle}\strut\insertframetitle\strut\par}%
    \ifx\insertframesubtitle\@empty\else
      \vspace{0.6mm}%
      {\usebeamerfont{framesubtitle}\usebeamercolor[fg]{framesubtitle}\insertframesubtitle\par}%
    \fi
  }}\vskip\PCLTitleGap
}
\setbeamertemplate{footline}{%
  \hbox to\paperwidth{\hfill{\fontsize{7}{9}\selectfont\color{PCLGray}\PCLPageNumber}\hspace*{4mm}}
  \vspace*{2mm}
}

\newcommand{\pcl@coverbackground}{%
  \begin{pclcanvas}
    \shade[top color=PCLDeepBlue,bottom color=PCLAccent]
      (0,0) rectangle (160,34.43);
    \fill[white] (80,34.93) circle (14.45);
    \begin{scope}
      \clip (80,34.93) circle (13.85);
      \node[inner sep=0] at (80,34.93)
        {\includegraphics[width=27.7mm]{\PCLAssetPath logo-cover.jpg}};
    \end{scope}
  \end{pclcanvas}
}
\newsavebox{\pcl@coverbox}
\newif\ifpcl@compactcover
\newcommand{\pcl@covertext}{%
  \begin{minipage}{140mm}\centering
    \ifpcl@compactcover
      \def\pcl@metafont{\fontsize{9.5}{10.5}\selectfont}%
      \def\pcl@covergap{0.5mm}%
      {\fontsize{14}{16}\selectfont\bfseries\color{PCLBlue}\inserttitle\par}%
    \else
      \def\pcl@metafont{\fontsize{10.5}{13}\selectfont}%
      \def\pcl@covergap{1.6mm}%
      {\usebeamerfont{title}\color{PCLBlue}\inserttitle\par}%
    \fi
    \ifx\insertsubtitle\@empty\else
      \vspace{\pcl@covergap}{\pcl@metafont\color{PCLGray}\insertsubtitle\par}%
    \fi
    \vspace{\pcl@covergap}{\pcl@metafont\textbf{汇报人：}\insertauthor\par}%
    \ifx\insertinstitute\@empty\else
      \vspace{\pcl@covergap}{\pcl@metafont\textbf{\insertinstitute}\par}%
    \fi
    \vspace{\pcl@covergap}{\pcl@metafont\bfseries\insertdate\par}%
  \end{minipage}%
}
\newcommand{\PCLTitleFrame}{%
  \begingroup
  \pcl@compactcoverfalse
  \sbox{\pcl@coverbox}{\pcl@covertext}%
  \ifdim\dimexpr\ht\pcl@coverbox+\dp\pcl@coverbox\relax>\PCLCoverHeight
    \pcl@compactcovertrue
    \sbox{\pcl@coverbox}{\pcl@covertext}%
  \fi
  \ifdim\dimexpr\ht\pcl@coverbox+\dp\pcl@coverbox\relax>\PCLCoverHeight
    \PackageError{beamerthemePCL}{Cover text exceeds the safe area}
      {Shorten the title, subtitle, author or institute. No automatic scaling below the compact font size is applied.}%
  \fi
  \setbeamertemplate{background}{\pcl@coverbackground}
  \begin{frame}[plain]
    \begin{pclcanvas}
      \node[inner sep=0] at (80,68.5) {\usebox{\pcl@coverbox}};
    \end{pclcanvas}
  \end{frame}
  \endgroup
}

