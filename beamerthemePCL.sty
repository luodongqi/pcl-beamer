\newcommand{\PCLFigureCaption}[1]{\par\vspace{1mm}{\fontsize{10}{13}\selectfont\color{PCLInk}#1\par}}
\newcommand{\PCLHeading}[1]{\par{\color{PCLBlue}\bfseries #1\par}\vspace{1.5mm}}
\newcommand{\PCLTitleColor}[1]{\setbeamercolor{frametitle}{fg=#1}}
